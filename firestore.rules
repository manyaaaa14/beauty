rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.admin == true ||
         request.auth.token.email.matches('.*@lelixir-beaute[.]com'));
    }

    // Services: Public read for published services, Admin full write
    match /services/{serviceId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Packages: Public read for active packages, Admin full write
    match /packages/{packageId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Offers: Public read for active offers, Admin full write
    match /offers/{offerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Gallery: Public read, Admin write
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings & Working Hours: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings:
    // Anyone can create a booking if basic validation passes
    // Only Admin can list all bookings or update/delete them
    // Customers can read their own specific booking if they know the booking ID
    match /bookings/{bookingId} {
      allow create: if request.resource.data.customerName is string &&
                       request.resource.data.customerPhone is string &&
                       request.resource.data.date is string &&
                       request.resource.data.time is string;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // Admins collection: strictly protected
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}

